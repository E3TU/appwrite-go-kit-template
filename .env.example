# Copy to .env and fill in. The template reads these; the library never does.

# --- required ---
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
# Internal URL used by the SDK. May be a container/private address.
APPWRITE_ENDPOINT=http://appwrite.local/v1
# Public URL used for browser-facing file links. Not the same as the internal
# endpoint unless the deployment really is reachable both ways.
APPWRITE_PUBLIC_ENDPOINT=https://appwrite.example.com/v1

# --- optional ---
# Defaults to a_session_<PROJECT_ID>.
APPWRITE_COOKIE_NAME=
# Go duration.
APPWRITE_TIMEOUT=30s
APPWRITE_SELF_SIGNED=false
# Header checked before the session cookie, for native clients.
APPWRITE_SESSION_HEADER=
# Listen address for the HTTP server.
APPWRITE_LISTEN=:8080

# --- capabilities ---
APPWRITE_AUTH_ENABLED=true
APPWRITE_DB_ENABLED=true
APPWRITE_DATABASE_ID=
# Table the todo handlers use. Defaults to "todos".
APPWRITE_TODOS_TABLE=todos

APPWRITE_STORAGE_ENABLED=false
APPWRITE_STORAGE_BUCKET=

APPWRITE_FUNCTIONS_ENABLED=false
